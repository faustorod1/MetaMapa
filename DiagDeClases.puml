@startuml

class Hecho{
- título: String
- descripción: String
- categoría: Categoria
- contenidoMultimedia: ContenidoMultimedia
- origen: OrigenHecho
- lugarAcontecimiento: Coordenada
- fechaHecho: LocalDate
- fechaDeCarga: LocalDateTime
- eliminado: boolean
- contribuyente: Contribuyente
- solicitudesDeEliminacion: List<SolicitudDeEliminacion>
- etiquetas: HashSet<Etiqueta>
--
+ solicitarEliminacion(String justificacion, Contribuyente contribuyente): SolicitudDeEliminacion
+ etiquetar(Etiqueta etiqueta): void
}
enum OrigenHecho{
CARGA_MANUAL
CONTRIBUYENTE
DATASET
}

enum CamposHecho{
 TITULO
 DESCRIPCION
 CATEGORIA
 LATITUD
 LONGITUD
 FECHADEHECHO
}

class Categoria{
- nombre: String
}

class Etiqueta{
- nombre: String
}

class Coleccion{
- titulo: String
- descripcion: String
- fuente: Fuente
- criterioDePertenencia: Criterio
- hechos: List<Hecho>
--
+ contiene (Hecho hecho): boolean
+ recalcularHechos(): void
}

class ContenidoMultimedia{}

class Criterio{
- filtros: ArrayList<Predicate<Hecho>>
--
+ aplicarA(List<Hecho> listaOriginal): List<Hecho>
}

class SolicitudDeEliminacion{
- descripcion: String
- hecho: Hecho
- fechaDeCarga: LocalDateTime
- fechaDeResolucion: LocalDateTime
- estado: EstadoSolicitud
- contribuyente: Contribuyente
- administradorQueResolvio: Administrador
- CANT_MINIMA_DE_CARACTERES: int = 500
--
+ resolver(Estado estado, Administrador administrador): void
}

enum EstadoSolicitud {
PENDIENTE
ACEPTADA
RECHAZADA
}

interface Fuente{
+ getHechos(): ArrayList<Hecho>
}

class FuenteEstatica{
- pathArchivo: String
--
+ getHechos(): ArrayList<Hecho>
}

class Coordenada{
- latitud: double
- longitud: double
--
+ comoArray(): double[]
+ equals(Coordenada other): boolean
}

class Administrador{
- nombre: String
- apellido: String
}

class Contribuyente{
- nombre: String
- apellido: String
- fechaNacimiento: LocalDate

+ getEdad(): int
}

class CSVReader{
 + leer(pathArchivo: String): static ArrayList<String[]>
 + leer(pathArchivo: String): ArrayList<Hecho>
}






Hecho --> Categoria
Hecho --> Coordenada
Hecho -->"*" SolicitudDeEliminacion
Hecho --> ContenidoMultimedia
Hecho --> OrigenHecho
Hecho -->"*" Etiqueta
Hecho --> Contribuyente

Coleccion -r-> Fuente
Coleccion --> Criterio
Coleccion -->"*" Hecho


Criterio .r.> Hecho

SolicitudDeEliminacion --> Hecho
SolicitudDeEliminacion --> EstadoSolicitud
SolicitudDeEliminacion --> Contribuyente
SolicitudDeEliminacion --> Administrador

FuenteEstatica .u.|> Fuente
FuenteEstatica ..> CSVReader

CSVReader --> CamposHecho


@enduml