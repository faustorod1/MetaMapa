@startuml

class Hecho{
- título: String
- descripción: String
- categoría: Categoria
- etiquetas: HashSet<String>
- contenidoMultimedia : ???
- origen: OrigenHecho
- lugarAcontecimiento: Coordenada
- fechaHecho: LocalDate
- fechaDeCarga: LocalDateTime
- solicitudesDeEliminacion: HashSet<SolicitudDeEliminacion>
- eliminado: boolean

+ print(): void
+ solicitarEliminacion(String justificacion): void
+ etiquetar(String etiqueta): void
}

class Categoria{
- nombre: String
}

class Contribuyente{
- nombre: String
- apellido: String
- edad: Integer
--
+ solicitarEliminacionDeHecho(Hecho hecho, String descripcion): void
+ publicarHecho(Hecho hecho): void ???
}

class Administrador {
--
+ crearColeccion(String titulo, String descripcion, Fuente fuente): Coleccion
+ juzgarEliminacionDeHecho(Hecho hecho): void
+ importarHechosDesdeCSV(): ?????
}

class Coleccion{
- titulo: String
- descripcion: String
- hechos: List<Hecho>
- fuente: Fuente
- criterioDePertenencia: Criterio
--
+ agregarHecho(Hecho hecho)): void
+ eliminarHecho(Hecho hecho): void
+ pertenece(Hecho hecho): boolean
}

class Criterio{
- filtros: ArrayList<Predicate<Hecho>>
--
+ conCategoria(Categoria categoria): Criterio
+ conFechaDeCargaDesde(LocalDateTime desde): Criterio
+ conFechaDeCargaHasta(LocalDatTime hasta): Criterio
+ conFechaDesde(LocalDateTime desde): Criterio
+ conFechaHasta(LocalDateTime hasta): Criterio
+ conTitulo(String titulo): Criterio
+ conDescripcion(String descripcion): Criterio
+ conLugar(Coordenada lugar): Criterio
+ aplicarA(List<Hecho> listaOriginal): List<Hecho>
}


class SolicitudDeEliminacion{
- descripcion: String
- hecho: Hecho
- estaPendiente: boolean
--
+ preguntar(): void
+ aceptar(): void
+ rechazar(): void
}

interface Fuente{
}

class FuenteEstatica{
- archivo: String
--
+ consultarCSV(String archivoCSV): List<Hecho>
}

class Coordenada{
- latitud : float
- longitud : float
--
+ comoArray() : float[]
+ equals(Coordenada other): boolean
}

Contribuyente .d.> Fuente
Administrador .d.> Fuente

Hecho --> Coordenada
Hecho -r->"*" Categoria
Hecho -d->"*" SolicitudDeEliminacion
Coleccion -->"*" Hecho
Coleccion --> Criterio

Hecho --> Fuente
Coleccion -r-> Fuente

Fuente -->"*" Hecho
FuenteEstatica .u.|> Fuente




@enduml