@startuml

class Hecho{

+ enum Origen
- título: String
- descripción: String
- categoría: Categoria
- origen: Origen
- lugarAcontecimiento: Coordenada
- fechaHecho: LocalDate
- fechaDeCarga: LocalDateTime
- eliminado: boolean
- solicitudesDeEliminacion: List<SolicitudDeEliminacion>
- etiquetas: HashSet<String>

+ print(): void
+ solicitarEliminacion(String justificacion): SolicitudDeEliminacion
+ etiquetar(String etiqueta): void
}

class Categoria{
- nombre: String
}


class Coleccion{
- titulo: String
- descripcion: String
- fuente: Fuente
- criterioDePertenencia: Criterio
- hechos: List<Hecho>
--
+ contiene (Hecho hecho): boolean
+ recalcularHechos(): void
}

class Criterio{
- filtros: ArrayList<Predicate<Hecho>>
--
+ aplicarA(List<Hecho> listaOriginal): List<Hecho>
}


class SolicitudDeEliminacion{
- descripcion: String
- hecho: Hecho
- estaPendiente: boolean
--
+ preguntar(): void
+ aceptar(): void
+ rechazar(): void
}

interface Fuente{
+ getHechos(): ArrayList<Hecho>;
}

class FuenteEstatica{
- archivo: String
--
+ getHechos(): ArrayList<Hecho>
}

class Coordenada{
- latitud : double
- longitud : double
--
+ comoArray() : double[]
+ equals(Coordenada other): boolean
}



Hecho --> Coordenada
Hecho -r->"*" Categoria
Hecho -d->"*" SolicitudDeEliminacion
Coleccion -->"*" Hecho
Coleccion --> Criterio

Hecho --> Fuente
Coleccion -r-> Fuente

Fuente -->"*" Hecho
FuenteEstatica .u.|> Fuente




@enduml